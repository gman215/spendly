# Copy this file to .env and fill in your values. .env is gitignored.

# Google Gemini API key for AI autofill (receipt scanning and quick add).
# Create one at https://aistudio.google.com/apikey. Leave it blank to turn AI autofill off.
GEMINI_API_KEY=

# Optional: use a different Gemini model (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional locally, required in production: the key Flask signs session cookies with.
# SECRET_KEY=replace-with-a-long-random-string
